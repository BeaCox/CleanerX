{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleanerX",
  "version": "0.1.0",
  "identifier": "com.cleanerx.CleanerX",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CleanerX",
        "hiddenTitle": true,
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": null
    }
  }
}
